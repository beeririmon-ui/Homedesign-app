# Copy to .dev.vars for local development (.dev.vars is gitignored). Names only; values are never committed.
# Preview / Production: `npx wrangler secret put <NAME> --env preview|production`.
# The providers themselves are vars in wrangler.jsonc (PAYMENT_PROVIDER, INVOICE_PROVIDER, SUPPLIER_PROVIDER), exact ids
# from a closed list (api/src/lib/config.ts); `mock` runs only outside production. A local override goes here too.

# S17 (AN1): Cloudflare Web Analytics is NOT a Worker var: the public build reads CF_ANALYTICS_TOKEN from its own
# environment (`CF_ANALYTICS_TOKEN=<the site token> HD_PUBLIC=1 npm run build`, docs/ops/deploy-runbook.md). Never set it
# here or commit it. A placeholder of its shape, for the record only:
# CF_ANALYTICS_TOKEN=00000000000000000000000000000000

# HMAC secret for the mock payment's webhook (locally any long random string: `openssl rand -hex 24`)
PAYMENT_WEBHOOK_SECRET=
# Grow (W1): the account values; GROW_DOCS_CONFIRMED=1 only once its documentation is in the repo and the adapter is done
GROW_USER_ID=
GROW_PAGE_CODE=
GROW_API_KEY=
GROW_DOCS_CONFIRMED=
# Invoices (W2: Grow's module, else Morning): its key, and the provider once it is built
INVOICE_API_KEY=
# CJ Dropshipping API key (supplier orders)
CJ_API_KEY=
# Local only: 1 lets /api/admin/* and /admin/* through without Cloudflare Access. Ignored outside ENVIRONMENT=development or test.
ADMIN_DEV_BYPASS=
# S13, local only: a request carrying this value in `x-hd-dev-admin` passes the admin gate (the e2e suite reads it from
# here). Honoured only when ENVIRONMENT is development, test or preview-local, and only 24 characters or longer.
ADMIN_DEV_TOKEN=
# S13: the new-order alert's provider (a var in wrangler.jsonc; `mock` writes a log row). No real channel is built yet.
# NOTIFY_PROVIDER=mock
